{
  "schemaVersion": 1,
  "merge": {
    "requiredChecks": [
      {
        "name": "verify",
        "workflow": "CI"
      }
    ]
  },
  "branch": {
    "types": [
      "feat",
      "fix",
      "docs",
      "style",
      "refactor",
      "perf",
      "test",
      "build",
      "ci",
      "chore",
      "revert"
    ],
    "exempt": [
      "main"
    ],
    "maxLength": null
  }
}
