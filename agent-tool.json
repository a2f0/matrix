{
  "schemaVersion": 1,
  "merge": {
    "requiredChecks": [
      {
        "name": "verify",
        "workflow": "CI"
      }
    ]
  },
  "branch": {
    "types": ["feat", "fix", "docs", "style", "refactor", "perf", "test", "build", "ci", "chore", "revert"],
    "exempt": ["main"],
    "maxLength": null
  },
  "graph": {
    "include": ["src/**", "skills/**", "scripts/**"],
    "tests": ["**/*.test.ts"],
    "layers": [
      {
        "name": "primitives",
        "include": [
          "src/gh.ts",
          "src/git.ts",
          "src/manifest.ts",
          "src/markdown.ts",
          "src/options.ts",
          "src/packageJson.ts",
          "src/teardown.ts",
          "src/testFixtures.ts",
          "src/testSetup.ts",
          "src/text.ts"
        ]
      },
      {
        "name": "checkouts",
        "include": ["src/checkouts.ts"]
      },
      {
        "name": "commands",
        "include": [
          "src/audit.ts",
          "src/auditCheckout.ts",
          "src/cycleGuards.ts",
          "src/discover.ts",
          "src/gitTransport.ts",
          "src/secrets.ts",
          "src/superseded.ts",
          "src/sweepLedger.ts",
          "src/sweepRetro.ts",
          "src/sweeps.ts"
        ]
      },
      {
        "name": "health",
        "include": ["src/health.ts"]
      },
      {
        "name": "cli",
        "include": ["src/cli.ts"]
      },
      {
        "name": "entry",
        "include": ["src/index.ts"]
      },
      {
        "name": "scripts",
        "include": ["skills/**", "scripts/**"]
      }
    ]
  }
}
