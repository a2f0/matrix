{
  "name": "matrix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent workspace for sweeping changes across managed repository checkouts",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "matrix": "bun src/index.ts",
    "sync": "bun src/index.ts sync",
    "status": "bun src/index.ts status",
    "discover": "bun src/index.ts discover",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "agent-tool": "agent-tool",
    "agents:sync": "bun run agent-tool skills install --apply",
    "agents:check": "bun run agent-tool skills check"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "agent-tool": "github:a2f0/agent-tool#ef1a91300c347ac13a1cb163d85ad734bfe81bf9",
    "typescript": "5.9.3"
  }
}
