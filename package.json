{
  "name": "matrix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent workspace for sweeping changes across managed repository checkouts",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "matrix": "bun src/index.ts",
    "sync": "bun src/index.ts sync",
    "status": "bun src/index.ts status",
    "discover": "bun src/index.ts discover",
    "audit": "bun src/index.ts audit",
    "health": "bun src/index.ts health",
    "sweep": "bun src/index.ts sweep",
    "space": "bun skills/space-cleanup/scripts/space-cleanup.ts",
    "artifacts": "bun skills/take-screenshots/scripts/artifacts.ts",
    "secrets:backup": "bash scripts/secrets/backupSecrets.sh",
    "secrets:deploy": "bun src/index.ts deploy-secrets",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "agent-tool": "agent-tool",
    "agent:run": "agent-tool run",
    "agent:logs": "agent-tool logs",
    "agents:sync": "bun run agent-tool skills install --apply && bun run agent-tool permissions install --apply",
    "agents:check": "bun run agent-tool skills check && bun run agent-tool permissions check",
    "check": "agent-tool run-group scripts/testing/verify.json",
    "lint:branch-name": "agent-tool branch check"
  },
  "devDependencies": {
    "@a2f0/agent-tool": "0.1.30",
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  }
}
